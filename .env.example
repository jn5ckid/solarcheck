# 연구실 PC에서만 사용합니다. 실제 키를 GitHub에 올리지 마세요.
VWORLD_API_KEY=
# 브이월드 키에 등록된 서비스 URL이 있으면 입력합니다. 기타(QGIS) 키는 우선 비워둡니다.
VWORLD_DOMAIN=
# 공공데이터포털: 국토교통부_건축HUB_건축물대장정보 서비스
# 일반 인증키(Decoding)를 사용하세요. Encoding 키도 처리합니다.
DATA_GO_KR_SERVICE_KEY=
SOLARCHECK_FLOOR_HEIGHT_M=
SOLARCHECK_ALLOWED_ORIGINS=
# 일사량 연구 자료 경로. 기본 연구 폴더는 solarcheck의 상위 폴더입니다.
SOLARCHECK_RESEARCH_ROOT=
SOLARCHECK_PIPELINE_ROOT=
